<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysMeetingMapper">

    <resultMap type="SysMeeting" id="SysMeetingResult">
        <result property="meetingId" column="meeting_id"/>
        <result property="title" column="title"/>
        <result property="password" column="password"/>
        <result property="holdUserId" column="hold_user_id"/>
        <result property="status" column="status"/>
        <result property="planStartTime" column="plan_start_time"/>
        <result property="planEndTime" column="plan_end_time"/>
        <result property="actStartTime" column="act_start_time"/>
        <result property="actEndTime" column="act_end_time"/>
    </resultMap>

    <sql id="selectSysMeetingVo">
        select meeting_id,
               title,
               password,
               hold_user_id,
               status,
               plan_start_time,
               plan_end_time,
               act_start_time,
               act_end_time
        from sys_meeting
    </sql>

    <select id="selectSysMeetingList" parameterType="SysMeeting" resultMap="SysMeetingResult">
        <include refid="selectSysMeetingVo"/>
        <where>
            <if test="title != null  and title != ''">and title = #{title}</if>
            <if test="password != null  and password != ''">and password = #{password}</if>
            <if test="status != null ">and status = #{status}</if>
            <if test="planStartTime != null ">and plan_start_time = #{planStartTime}</if>
            <if test="planEndTime != null ">and plan_end_time = #{planEndTime}</if>
        </where>
    </select>

    <select id="selectSysMeetingByMeetingId" parameterType="String" resultMap="SysMeetingResult">
        <include refid="selectSysMeetingVo"/>
        where meeting_id = #{meetingId}
    </select>

    <insert id="insertSysMeeting" parameterType="SysMeeting">
        insert into sys_meeting
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="meetingId != null">meeting_id,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="password != null">password,</if>
            <if test="holdUserId != null">hold_user_id,</if>
            <if test="status != null">status,</if>
            <if test="planStartTime != null">plan_start_time,</if>
            <if test="planEndTime != null">plan_end_time,</if>
            <if test="actStartTime != null">act_start_time,</if>
            <if test="actEndTime != null">act_end_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="meetingId != null">#{meetingId},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="password != null">#{password},</if>
            <if test="holdUserId != null">#{holdUserId},</if>
            <if test="status != null">#{status},</if>
            <if test="planStartTime != null">#{planStartTime},</if>
            <if test="planEndTime != null">#{planEndTime},</if>
            <if test="actStartTime != null">#{actStartTime},</if>
            <if test="actEndTime != null">#{actEndTime},</if>
        </trim>
    </insert>

    <update id="updateSysMeeting" parameterType="SysMeeting">
        update sys_meeting
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="password != null">password = #{password},</if>
            <if test="holdUserId != null">hold_user_id = #{holdUserId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="planStartTime != null">plan_start_time = #{planStartTime},</if>
            <if test="planEndTime != null">plan_end_time = #{planEndTime},</if>
            <if test="actStartTime != null">act_start_time = #{actStartTime},</if>
            <if test="actEndTime != null">act_end_time = #{actEndTime},</if>
        </trim>
        where meeting_id = #{meetingId}
    </update>

    <delete id="deleteSysMeetingByMeetingId" parameterType="String">
        delete
        from sys_meeting
        where meeting_id = #{meetingId}
    </delete>

    <delete id="deleteSysMeetingByMeetingIds" parameterType="String">
        delete from sys_meeting where meeting_id in
        <foreach item="meetingId" collection="array" open="(" separator="," close=")">
            #{meetingId}
        </foreach>
    </delete>
</mapper>